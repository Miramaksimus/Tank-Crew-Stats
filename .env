# Copy this file to ".env" and adjust values. docker compose reads it automatically.

# --- Database ---------------------------------------------------------------
DB_NAME=il2_stats
DB_USER=il2_stats
DB_PASSWORD=il2_stats

# --- Web --------------------------------------------------------------------
# Host port the site is published on (container always listens on 8077).
HTTP_PORT=8077

# Stable Django secret key so sessions survive restarts.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=90ySudOau9SHjv-aDR6uNL5Uu3PQ9lxggAC-JW9KNQaZq_4huOs5giEU8UmlqoAmb2U

# Auto-create an admin user on first start (optional; leave blank to skip).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Parser (optional) ------------------------------------------------------
# Path to your IL-2 dedicated server folder (the one containing "data/").
IL2_SERVER_PATH=E:/GAMES/tc_server
